import random
import time
import sys

sys.setrecursionlimit(20000)

comparisons = 0

def partition(arr, low, high):
    global comparisons

    pivot = arr[high]
    i = low - 1

    for j in range(low, high):
        comparisons += 1

        if arr[j] <= pivot:
            i += 1
            arr[i], arr[j] = arr[j], arr[i]

    arr[i + 1], arr[high] = arr[high], arr[i + 1]

    return i + 1


def deterministic_quicksort(arr, low, high):
    if low < high:
        pivot = partition(arr, low, high)

        deterministic_quicksort(
            arr,
            low,
            pivot - 1
        )

        deterministic_quicksort(
            arr,
            pivot + 1,
            high
        )


def randomized_quicksort(arr, low, high):
    if low < high:
        random_index = random.randint(low, high)

        arr[random_index], arr[high] = (
            arr[high],
            arr[random_index]
        )

        pivot = partition(arr, low, high)

        randomized_quicksort(
            arr,
            low,
            pivot - 1
        )

        randomized_quicksort(
            arr,
            pivot + 1,
            high
        )


def test_algorithm(sort_function, data):
    global comparisons

    arr = data[:]
    comparisons = 0

    start = time.perf_counter()

    sort_function(arr, 0, len(arr) - 1)

    end = time.perf_counter()

    return comparisons, (end - start) * 1000


n = 5000

test_cases = {
    "Random": [random.randint(1, 100000) for _ in range(n)],
    "Sorted": list(range(n)),
    "Reverse": list(range(n, 0, -1)),
    "Nearly Sorted": list(range(n))
}

for _ in range(n // 20):
    i = random.randint(0, n - 1)
    j = random.randint(0, n - 1)
    test_cases["Nearly Sorted"][i], test_cases["Nearly Sorted"][j] = (
        test_cases["Nearly Sorted"][j],
        test_cases["Nearly Sorted"][i]
    )

for name, data in test_cases.items():
    d_comparisons, d_time = test_algorithm(
        deterministic_quicksort,
        data
    )

    r_comparisons, r_time = test_algorithm(
        randomized_quicksort,
        data
    )

    print("\n", name)
    print("Deterministic Comparisons:", d_comparisons)
    print("Deterministic Time:", d_time, "ms")
    print("Randomized Comparisons:", r_comparisons)
    print("Randomized Time:", r_time, "ms")
